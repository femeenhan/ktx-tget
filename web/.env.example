# 운영 값은 Vercel 환경변수에 있다. 로컬에서 운영 DB를 쓰려면:
#   vercel env pull .env.production.local --environment=production --yes
# (ADMIN_PASSWORD·SESSION_SECRET·CRON_SECRET은 민감 변수라 빈 값으로 내려온다 → ~/keystores/tget-web-secrets.txt)

# Neon Postgres (Vercel Marketplace 연동이 주입)
DATABASE_URL=
# Vercel Blob 스토어 tget-apk (연동이 주입). APK 업로드에 필요
BLOB_READ_WRITE_TOKEN=
# /admin 로그인 비밀번호
ADMIN_PASSWORD=
# 관리자 세션 쿠키 서명 키 (openssl rand -base64 32)
SESSION_SECRET=
# Vercel Cron 인증 (openssl rand -base64 32)
CRON_SECRET=
# memory: DB 없이 로컬 개발
REPO=
