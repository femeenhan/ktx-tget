## Android SDK path (Android Studio default shown)
sdk.dir=/path/to/Android/sdk

## Release signing (keep private — do not commit; back up the keystore AND these passwords together)
keystorePath=/Users/you/keystores/ktxtget-release.jks
keystorePassword=your_store_password
keyAlias=ktxtget
keyPassword=your_key_password

## Optional: override the license server base URL
# apiBaseUrl=https://tget.bigseasons.co.kr
